# Where Jellyfin answers, as seen from this app (a container name works when both share a network).
LOMBO_HANGUP_JELLYFIN_URL=http://jellyfin:8096
# Jellyfin: Dashboard > API Keys > +. One key per app, so you can revoke it alone.
LOMBO_HANGUP_JELLYFIN_API_KEY=changeme
# Optional. Any webhook that accepts JSON (Discord, Slack, or a bridge). Empty means no alerts.
LOMBO_HANGUP_WEBHOOK_URL=
# true = show what looks stuck and close nothing. Set false only after reading the output of `plan`.
LOMBO_HANGUP_DRY_RUN=true
# A stream is left alone until nobody new has joined it for this long (seconds). At least 60.
LOMBO_HANGUP_GRACE_SECONDS=600
# Seconds between rounds when running with --loop. At least 60.
LOMBO_HANGUP_INTERVAL_SECONDS=300
